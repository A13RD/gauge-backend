# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Base de Datos PostgreSQL / Supabase
# Nota: Si tu red es IPv4, utiliza la URL del Connection Pooler (puerto 6543 o 5432 con aws-0-[region].pooler.supabase.com)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require"

# Seguridad y Autenticación JWT
JWT_SECRET="clave_secreta_gauge_2026"
JWT_EXPIRES_IN="24h"

# Almacenamiento de Archivos (Supabase Storage)
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_BUCKET="game-covers"

# Configuración CORS Frontend (admite URLs separadas por coma)
FRONTEND_URL="http://localhost:3000"

